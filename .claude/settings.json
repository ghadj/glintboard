{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(xcrun swift-format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(swift package *)",
      "Bash(scripts/check-native-only.sh*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(make help*)",
      "Bash(make test*)",
      "Bash(make build*)",
      "Bash(make lint*)",
      "Bash(make format*)",
      "Bash(make check*)",
      "Bash(make ci*)",
      "Bash(scripts/check-branding.sh*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(open *)",
      "Bash(tccutil *)",
      "Edit(**/*.entitlements)",
      "Edit(**/Info.plist)",
      "Edit(Config/*.xcconfig)",
      "Edit(**/*.pbxproj)",
      "Bash(make run*)",
      "Bash(make clean*)",
      "Bash(make bootstrap*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Keychains/**)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/org.swift.swiftpm"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/Library/Mail",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
